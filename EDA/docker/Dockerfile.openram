# The Grafux OPENRAM image: the VLSIDA memory compiler, reachable over SSH.
#
# WHY A THIRD IMAGE.  ../Dockerfile builds on openroad/orfs and Dockerfile.verify
# on a Verilator/cocotb stack.  OpenRAM needs neither: it is a pure-Python
# compiler that writes GDS itself, so it shares nothing with the other two but
# the transport.  Building it on the ORFS image would pay several gigabytes of
# pull, on every cold pod, for tools the compiler never invokes -- the same trade
# Dockerfile.verify already refused, and for the same reason.
#
# WHAT IT DELIBERATELY DOES NOT CARRY, and why that is not a gap:
#   * no ngspice/hspice -- EDA/flow.py always writes ``analytical_delay = True``,
#     because with it off characterization dies at the very end, after all the
#     layout work is already paid for.
#   * no magic/netgen   -- ``check_lvsdrc`` is False unless the block's
#     `check_lvsdrc` port asks, and run_openram warns when it does.  Upstream's
#     own default is off too, so this is the ordinary path, not a limitation.
#   * no sky130 PDK by default -- see WITH_SKY130 below.
# Adding any of them is a separate TAG, not a change to this one: they are what
# turns a ~1 GB image with a fast cold start back into an ORFS-sized pull.
#
# Same sshd contract as the other two images, and for the same reason: RunPod
# injects a key through PUBLIC_KEY but does NOT add an sshd to an arbitrary
# image, and a pod with nothing listening on port 22 fails provisioning with a
# completely misleading "does not provide direct public-IP networking" error.
# start.sh is shared verbatim with the other two.
#
# Build and push (PIN THE TAG; see EDA/models.py DEFAULT_OPENRAM_IMAGE):
#   docker build -t ghcr.io/dalifahmy/grafux-openram:v1_2_48-scn4m-20260912 \
#       -f EDA/docker/Dockerfile.openram EDA/docker
#   docker push  ghcr.io/dalifahmy/grafux-openram:v1_2_48-scn4m-20260912
#
# The pushed GHCR package must be PUBLIC: RunPod pulls anonymously, and a private
# package fails the pull with the same misleading error as a missing sshd.
#
# Verify before shipping a new tag -- and note that "it imports" proves nothing
# here.  What breaks is a config OPTION OpenRAM no longer accepts, so the check
# that matters is compiling a config generated by EDA/flow.py's own
# build_openram_config and listing what comes out.  That is exactly what
# .github/workflows/build-openram-image.yml does; run it rather than hand-rolling
# a config, or the thing under test stops being the thing that ships.
#
# Local development (no RunPod account, no spend) -- what EDA_LOCAL_SSH=1 talks to:
#   ssh-keygen -t rsa -b 2048 -f /tmp/eda_key -N ''
#   docker run -d --name grafux-openram -p 2222:22 \
#       -e PUBLIC_KEY="$(cat /tmp/eda_key.pub)" <img>
#   EDA_LOCAL_SSH=1 EDA_LOCAL_KEY=/tmp/eda_key uvicorn device.app:app

# ubuntu:22.04 to match the other two images: one libc and one Python version
# across the fleet means a macro compiled on a pod behaves the same as one
# compiled in CI.
FROM ubuntu:22.04

# python3-dev and build-essential are not optional: several of OpenRAM's
# requirements build native extensions at pip time.
#
# `curl` is deliberately ABSENT, and that is load-bearing rather than an
# oversight.  Every run starts by executing OpenRAM's own install_conda.sh, which
# tries to fetch a ~100 MB miniconda and build a second environment; with no curl
# it fails in a few harmless lines and the compiler carries on with the venv
# below.  Verified on the first real compile (CI run 34683094775): a 2x16
# scn4m_subm macro completes in 16.9 s, every view written, with that script
# failing noisily first.  Adding curl would make it SUCCEED -- downloading
# miniconda on every cold pod for an environment nothing here uses.  The noise
# lands on the block's `log` port; it is not an error.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        openssh-server rsync ca-certificates git \
        python3 python3-venv python3-dev build-essential \
 && mkdir -p /var/run/sshd /root/.ssh \
 && chmod 700 /root/.ssh \
 && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
 && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
 && rm -rf /var/lib/apt/lists/*

# PIN THIS to a tag or a commit, never to a branch.  OpenRAM has moved its entry
# point and renamed config options across releases, so an unpinned checkout turns
# a working block into a config-option error on a pod the user is already paying
# for.  The same lesson DEFAULT_IMAGE and the gpu block's CUDA pin both record.
ARG OPENRAM_REF=v1.2.48
RUN git clone --depth 1 --branch "${OPENRAM_REF}" \
        https://github.com/VLSIDA/OpenRAM.git /opt/openram

# Its own virtualenv, not the system python -- exactly the split
# Dockerfile.verify makes for cocotb, and for the same reason: a shared
# site-packages is how one tool's dependency upgrade breaks another tool.
RUN python3 -m venv /opt/openram-venv \
 && /opt/openram-venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/openram-venv/bin/pip install --no-cache-dir -r /opt/openram/requirements.txt

# sky130 needs a full PDK fetched at build time plus the SRAM cell views
# installed into the technology tree -- gigabytes, a long build, and a version
# coupling to magic and netgen.  scn4m_subm and freepdk45 ship INSIDE the
# OpenRAM repository and cost nothing, which is why they are what this tag
# carries and why sky130 is a build ARG rather than a default.  Turning it on
# produces a DIFFERENT TAG (grafux-openram:sky130-<date>), and
# OPENRAM_TECH_CHOICES in EDA/models.py grows only once such a tag exists.
ARG WITH_SKY130=0
RUN if [ "${WITH_SKY130}" = "1" ]; then \
        cd /opt/openram && make sky130-pdk && make sky130-install; \
    fi

# THIS is how image-level configuration reaches a real run.  An SSH exec does
# NOT inherit Docker ENV -- that is the whole reason _EDA_ENV exists in
# pod_client.py -- but EDA/flow.py invokes everything through `bash -lc`, and a
# login shell sources /etc/profile.d.  So the entry point lives here, and an
# OpenRAM release that moves it is a change to this file rather than to flow.py.
#
# _OPENRAM_ENV in flow.py supplies the same three values with ``:-`` defaults,
# so a pre-2026 image still works.  Do not delete either as redundant: this one
# serves a real run, the ENV below serves `docker run ... bash -lc` smoke tests.
RUN printf '%s\n' \
      'export OPENRAM_HOME=/opt/openram/compiler' \
      'export OPENRAM_TECH=/opt/openram/technology' \
      'export GRAFUX_OPENRAM_CMD="python3 /opt/openram/sram_compiler.py"' \
      > /etc/profile.d/openram.sh \
 && chmod 0644 /etc/profile.d/openram.sh

ENV OPENRAM_HOME=/opt/openram/compiler \
    OPENRAM_TECH=/opt/openram/technology \
    GRAFUX_OPENRAM_CMD="python3 /opt/openram/sram_compiler.py" \
    PYTHONPATH=/opt/openram/compiler \
    PATH="/opt/openram-venv/bin:${PATH}"

COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 22
CMD ["/start.sh"]
